# Copie para .env.local e preencha. Nunca use o prefixo VITE_ aqui: a chave precisa ficar só no servidor.

# Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional. Padrão: gemini-3.5-flash-lite (reserva automática: gemini-3.6-flash)
GEMINI_MODEL=

# Supabase (opcional; sem isso as contas ficam só no aparelho). Project Settings → API. Valores públicos, por isso VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "true" depois de configurar o Google em Authentication → Providers → Google
VITE_AUTH_GOOGLE=

# AdSense (opcional; sem isso o app não mostra anúncios). Estes valores são públicos, por isso o prefixo VITE_.
# ID de publicador, ex.: ca-pub-1234567890123456 (gera também o /ads.txt no build)
VITE_ADSENSE_CLIENT=
# Um bloco de anúncio responsivo para cada lugar (painel do AdSense → Anúncios → Por bloco de anúncios)
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_RESULT=
VITE_ADSENSE_SLOT_HISTORY=
VITE_ADSENSE_SLOT_SCANNER=
VITE_ADSENSE_SLOT_WALLET=
VITE_ADSENSE_SLOT_MENU=
